{
  "name": "@m407/opencode-mattermost-bot",
  "version": "0.26.3",
  "description": "Mattermost client for OpenCode: coding tasks, sessions, permissions, files and scheduling.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "opencode-mattermost": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./mattermost": "./dist/mattermost/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": "^22.14.0 || ^23.6.0 || >=24"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:rc": "node scripts/release-prepare.mjs rc",
    "release:notes:preview": "node scripts/release-notes-preview.mjs",
    "lint": "oxlint src tests --max-warnings=0",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:runtime": "npm run build && node scripts/smoke-runtime.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m407/opencode-telegram-bot.git"
  },
  "keywords": [
    "opencode",
    "mattermost",
    "mattermost-bot",
    "developer-tools",
    "cli"
  ],
  "author": "grinev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/m407/opencode-telegram-bot/issues"
  },
  "homepage": "https://github.com/m407/opencode-telegram-bot#readme",
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "@opencode/client": "^2.0.16",
    "dotenv": "^17.4.2",
    "ws": "^8.21.1"
  },
  "overrides": {
    "google-gax": {
      "rimraf": "^6.1.3"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "1.86.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
